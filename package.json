{
  "name": "goggle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "cd wasm && GOOS=js GOARCH=wasm go build -o ../src/assets/goggle.wasm && cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" ../src/assets",
    "dev": "vite",
    "prebuild": "cd wasm && GOOS=js GOARCH=wasm go build -o ../src/assets/goggle.wasm && cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" ../src/assets",
    "build": "tsc -b && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  }
}
